{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blahdiem-docs",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "docs.blahim.com/blahdiem", "zone_name": "blahim.com" },
    { "pattern": "docs.blahim.com/blahdiem/*", "zone_name": "blahim.com" }
  ]
}
